    {
      "name": "Turnos",
      "item": [
        {
          "name": "Crear turno",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"turnoId\", jsonData.id);",
                  "    pm.test(\"Turno creado (201) y turnoId guardado\", function () {",
                  "        pm.response.to.have.status(201);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"2026-10-15\",\n  \"hora\": \"21:00\",\n  \"cantidadComensales\": 4,\n  \"clienteId\": {{clienteId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/turnos/crearTurno",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "turnos",
                "crearTurno"
              ]
            },
            "description": "Los 4 campos son obligatorios; cantidadComensales >= 1; el cliente debe existir. Fecha yyyy-MM-dd, hora HH:mm. Arranca en estado PENDIENTE. 201 Created. 400 validación, 404 cliente inexistente."
          }
        },
        {
          "name": "Listar turnos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/turnos/listarTurnos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "turnos",
                "listarTurnos"
              ]
            },
            "description": "200 OK con un array de turnos."
          }
        },
        {
          "name": "Obtener turno por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/turnos/obtenerTurno/{{turnoId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "turnos",
                "obtenerTurno",
                "{{turnoId}}"
              ]
            },
            "description": "200 OK. 404 si no existe."
          }
        },
        {
          "name": "Agregar plato al turno (pre-pedido)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/turnos/{{turnoId}}/platos/{{platoId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "turnos",
                "{{turnoId}}",
                "platos",
                "{{platoId}}"
              ]
            },
            "description": "Sin body. Primer id = turno, segundo = plato. Relación muchos a muchos. 200 OK con el plato dentro de 'platos'. 404 si el turno o el plato no existen."
          }
        },
        {
          "name": "Asociar pago al turno",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"monto\": 34000.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/turnos/{{turnoId}}/pago",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "turnos",
                "{{turnoId}}",
                "pago"
              ]
            },
            "description": "monto obligatorio y no negativo. Se crea en PENDIENTE con fecha automática. Relación uno a uno. 200 OK con el objeto pago."
          }
        },
        {
          "name": "Cambiar estado",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/turnos/cambiarEstado/{{turnoId}}?estado=CONFIRMADO",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "turnos",
                "cambiarEstado",
                "{{turnoId}}"
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "CONFIRMADO",
                  "description": "Valores válidos: PENDIENTE, CONFIRMADO, CANCELADO"
                }
              ]
            },
            "description": "Sin body. El estado va como query param (@RequestParam). 200 OK. 400 si falta o es inválido, 404 si el turno no existe."
          }
        },
        {
          "name": "Actualizar turno",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"2026-10-20\",\n  \"hora\": \"20:30\",\n  \"cantidadComensales\": 6,\n  \"clienteId\": {{clienteId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/turnos/actualizarTurno/{{turnoId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "turnos",
                "actualizarTurno",
                "{{turnoId}}"
              ]
            },
            "description": "Mismo body que crear; hay que mandar todos los campos. No modifica estado, platos ni pago. 200 OK. 400, 404 (turno o cliente inexistente)."
          }
        },
        {
          "name": "Eliminar turno",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/turnos/eliminarTurno/{{turnoId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "turnos",
                "eliminarTurno",
                "{{turnoId}}"
              ]
            },
            "description": "Último paso: después de esto el turno ya no existe. 204 No Content. 404 si no existía."
          }
        }
      ]
    },
