  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "clienteId",
      "value": "",
      "type": "string"
    },
    {
      "key": "platoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "turnoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "pagoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Crear cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"clienteId\", jsonData.id);",
                  "    pm.test(\"Cliente creado (201) y clienteId guardado\", function () {",
                  "        pm.response.to.have.status(201);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"email\": \"juan.perez@mail.com\",\n  \"telefono\": \"1134567890\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/clientes/crearCliente",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "clientes",
                "crearCliente"
              ]
            },
            "description": "nombre, apellido y email obligatorios; email con formato válido; telefono opcional. 201 Created. 400 si falla alguna validación."
          }
        },
        {
          "name": "Listar clientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/clientes/listarClientes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "clientes",
                "listarClientes"
              ]
            },
            "description": "200 OK con un array (o [] si no hay clientes)."
          }
        },
        {
          "name": "Obtener cliente por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/clientes/obtenerCliente/{{clienteId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "clientes",
                "obtenerCliente",
                "{{clienteId}}"
              ]
            },
            "description": "200 OK. 404 si no existe el id."
          }
        },
        {
          "name": "Crear cliente - ejemplo error 400",
          "request": {
